<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Updates for people the app is shared with (com.anyapp.updates, Kiwimake docs/DISTRIBUTION.md):
       the app installs its own new version, checks once a day when online, and asks Kiwimake
       first whether it handles this app (then the app stays silent). -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <queries>
    <intent>
      <action android:name="com.anyappagent.action.UPDATES" />
    </intent>
    <intent>
      <action android:name="com.anyappagent.action.CHANGE" />
      <data android:scheme="anyappagent" />
    </intent>
  </queries>
  <application>
    <!-- "Change this app" when Kiwimake is not on the phone (com.anyapp.updates.ChangeSheet): keep it. -->
    <activity
      android:name="com.anyapp.updates.ChangeSheet"
      android:exported="false"
      android:excludeFromRecents="true"
      android:configChanges="uiMode|orientation|screenSize|keyboardHidden"
      android:windowSoftInputMode="adjustResize"
      android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    <activity
      android:name="com.anyapp.updates.UpdateActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:theme="@android:style/Theme.DeviceDefault.Light.Dialog.NoActionBar" />
    <service
      android:name="com.anyapp.updates.UpdateJob"
      android:exported="false"
      android:permission="android.permission.BIND_JOB_SERVICE" />
    <receiver
      android:name="com.anyapp.updates.InstallReceiver"
      android:exported="false" />
    <!-- Kiwimake says a new version of this app is ready (quick update or APK): the Reload
         popup (com.anyapp.updates.ReadyPopup, docs/FAST-LANE.md). -->
    <receiver
      android:name="com.anyapp.updates.ReadyReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="com.anyapp.updates.READY" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
