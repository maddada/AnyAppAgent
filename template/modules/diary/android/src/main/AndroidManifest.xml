<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- AnyAppAgent asks for the app's diary (its agent on the PC wants to read it). The answer goes
         only to the app that installed this one (AnyAppAgent), so asking is harmless. -->
    <receiver
        android:name="expo.modules.anyappdiary.DiaryRequestReceiver"
        android:exported="true">
      <intent-filter>
        <action android:name="com.anyapp.action.DIARY_REQUEST" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
