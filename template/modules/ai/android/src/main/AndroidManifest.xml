<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- AI goes through AnyAppAgent on this phone (it holds the key): the app must be able to see it
       (Android 11+ package visibility) to bind to its AI service and to open its settings. -->
  <queries>
    <package android:name="com.anyappagent" />
    <intent>
      <action android:name="com.anyappagent.action.AI" />
    </intent>
  </queries>
</manifest>
