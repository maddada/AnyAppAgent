{
  "name": "anyappagent-desktop",
  "productName": "Kiwimake",
  "version": "0.3.3",
  "private": true,
  "description": "Kiwimake for Windows: runs the companion, onboarding, connect a phone.",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite build && electron .",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "fake-companion": "node dev/fake-companion.mjs",
    "dist": "pwsh -NoProfile -File dev/release-windows.ps1",
    "dist:mac": "node dev/build-mac.mjs"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "ws": "8.22.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "build": {
    "appId": "com.anyappagent.desktop",
    "productName": "Kiwimake",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "companion/server",
        "filter": [
          "src/**",
          "bin/**",
          "easy-connect/**",
          "package.json",
          "package-lock.json",
          "THIRD_PARTY_NOTICES.md",
          "!**/node_modules/**",
          "!**/build/**",
          "!**/test/**"
        ]
      },
      {
        "from": "../shared",
        "to": "companion/shared",
        "filter": [
          "**/*",
          "!**/.vitest-cache/**",
          "!theme/directions.html",
          "!theme/system.html",
          "!theme/renders/**",
          "!**/node_modules/**",
          "!**/test/**",
          "!**/*.test.*"
        ]
      },
      {
        "from": "../builder",
        "to": "companion/builder",
        "filter": [
          "**/*",
          "!test/**",
          "!**/.vitest-cache/**"
        ]
      },
      {
        "from": "../template",
        "to": "companion/template",
        "filter": [
          "**/*",
          "!build/**",
          "!android/**",
          "!**/.vitest-cache/**"
        ]
      },
      {
        "from": "../shared/theme/mark/windows",
        "to": "mark",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../template-kotlin",
        "to": "companion/template-kotlin",
        "filter": [
          "**/*",
          "!**/node_modules/**",
          "!**/build/**",
          "!**/.gradle/**"
        ]
      },
      {
        "from": "../template-exact",
        "to": "companion/template-exact",
        "filter": [
          "**/*",
          "!**/node_modules/**",
          "!**/build/**",
          "!**/.gradle/**"
        ]
      }
    ],
    "win": {
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://time.certum.pl"
      },
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../shared/theme/mark/windows/anyappagent.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Kiwimake-Setup-${version}.exe",
      "shortcutName": "Kiwimake",
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "installerIcon": "../shared/theme/mark/windows/anyappagent.ico",
      "uninstallerIcon": "../shared/theme/mark/windows/anyappagent.ico"
    },
    "afterPack": "./dev/after-pack.cjs",
    "electronLanguages": [
      "en-US",
      "en-GB",
      "ar"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "../shared/theme/mark/mac/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Kiwimake-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "minimumSystemVersion": "12.0",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Kiwimake listens only while you dictate a message to your app's chat.",
        "LSApplicationCategoryType": "public.app-category.developer-tools"
      },
      "extraResources": [
        {
          "from": "../shared/theme/mark/mac",
          "to": "mark",
          "filter": [
            "trayTemplate.png",
            "trayTemplate@2x.png"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Kiwimake",
      "artifactName": "Kiwimake-mac-${arch}.${ext}"
    }
  }
}
