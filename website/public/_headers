/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; style-src 'self'; img-src 'self'; script-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Ready apps (docs/GALLERY.md): the gallery list Kiwimake reads on the phone and the PC.
/gallery.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300
  Content-Type: application/json; charset=utf-8
