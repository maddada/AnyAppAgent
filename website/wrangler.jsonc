{
  "name": "kiwimake-website",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "routes": [
    { "pattern": "kiwimake.ai", "custom_domain": true },
    { "pattern": "www.kiwimake.ai", "custom_domain": true },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
  },
}
