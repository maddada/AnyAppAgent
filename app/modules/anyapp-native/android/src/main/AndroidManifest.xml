<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
  <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

  <application>
    <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.anyapp.fileprovider"
        android:exported="false"
        android:grantUriPermissions="true">
      <meta-data
          android:name="android.support.FILE_PROVIDER_PATHS"
          android:resource="@xml/anyapp_file_paths" />
    </provider>

    <receiver
        android:name="com.anyappagent.nativebridge.InstallResultReceiver"
        android:exported="false" />

    <!-- Crash reports and diaries from apps made with AnyAppAgent (docs/VERSIONS.md). Exported on
         purpose: each broadcast carries a PendingIntent whose creator Android stamps, and only apps
         this AnyAppAgent installed itself are accepted (AppReports.kt). -->
    <receiver
        android:name="com.anyappagent.nativebridge.AppReportsReceiver"
        android:exported="true">
      <intent-filter>
        <action android:name="com.anyappagent.action.CRASH" />
        <action android:name="com.anyappagent.action.DIARY" />
      </intent-filter>
    </receiver>
    <!-- AnyAppAgent first (docs/DISTRIBUTION.md stage 5): apps made with AnyAppAgent find it by this
         action and ask the provider whether it handles their updates (then they stay silent). -->
    <provider
        android:name="com.anyappagent.nativebridge.UpdatesProvider"
        android:authorities="${applicationId}.updates"
        android:exported="true" />
    <service
        android:name="com.anyappagent.nativebridge.UpdatesHostService"
        android:exported="true">
      <intent-filter>
        <action android:name="com.anyappagent.action.UPDATES" />
      </intent-filter>
    </service>

    <service
        android:name="com.anyappagent.nativebridge.KeepAliveService"
        android:exported="false"
        android:foregroundServiceType="dataSync" />
  </application>
</manifest>
