{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../shared/*"],
      "anyapp-native": ["./modules/anyapp-native/src"],
      "anyapp-ai": ["./modules/anyapp-ai/src"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../shared/protocol.ts"],
  "exclude": ["node_modules", "dist", "android", "dev"]
}
