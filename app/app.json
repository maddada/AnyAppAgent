{
  "expo": {
    "name": "AnyAppAgent",
    "slug": "anyappagent",
    "scheme": "anyappagent",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "../shared/theme/mark/android/expo/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F3EFE7",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.anyappagent",
      "versionCode": 200,
      "adaptiveIcon": {
        "foregroundImage": "../shared/theme/mark/android/expo/adaptive-foreground.png",
        "backgroundColor": "#1D6A4A",
        "monochromeImage": "../shared/theme/mark/android/expo/adaptive-monochrome.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.REQUEST_DELETE_PACKAGES",
        "android.permission.QUERY_ALL_PACKAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        { "action": "SEND", "category": ["DEFAULT"], "data": [{ "mimeType": "image/*" }] },
        { "action": "SEND_MULTIPLE", "category": ["DEFAULT"], "data": [{ "mimeType": "image/*" }] },
        { "action": "SEND", "category": ["DEFAULT"], "data": [{ "mimeType": "text/plain" }] }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "AnyAppAgent uses the camera to scan the code your PC shows.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AnyAppAgent lets you send pictures to the agent that makes your app.",
          "cameraPermission": "AnyAppAgent uses the camera to scan the code your PC shows and to take pictures for your apps.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-secure-store",
      "expo-image",
      [
        "expo-font",
        {
          "fonts": [
            "../shared/theme/fonts/BricolageGrotesque-Display-Bold.ttf",
            "../shared/theme/fonts/BricolageGrotesque-Display-ExtraBold.ttf",
            "../shared/theme/fonts/BricolageGrotesque-Text-Regular.ttf",
            "../shared/theme/fonts/BricolageGrotesque-Text-Medium.ttf",
            "../shared/theme/fonts/BricolageGrotesque-Text-SemiBold.ttf",
            "../shared/theme/fonts/BricolageGrotesque-Text-Bold.ttf",
            "../shared/theme/fonts/IBMPlexMono-Regular.ttf",
            "../shared/theme/fonts/IBMPlexMono-Medium.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
