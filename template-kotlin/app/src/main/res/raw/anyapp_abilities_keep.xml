<?xml version="1.0" encoding="utf-8"?>
<!-- Phone abilities (com.anyapp.abilities) find the widget layout and its parts by name, so
     resource shrinking must keep them. Keep this file. -->
<resources xmlns:tools="http://schemas.android.com/tools"
  tools:keep="@layout/anyapp_widget,@drawable/anyapp_widget_*,@color/anyapp_widget_*,@dimen/anyapp_widget_*,@style/AnyappWidget*" />
