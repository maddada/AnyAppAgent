# Build output anywhere: APKs and logs (build/apk/, build/logs/) and Gradle's own output
# (app/build/, .gradle/, .kotlin/). After a build, `git status` must show only what was changed
# by hand (and the launcher icon sizes when icon.png changed).
build/
.gradle/
.kotlin/
.cxx/
*.hprof
local.properties
*.iml
.idea/
captures/

# Signing material never lives in the app (AnyAppAgent keeps every key outside the app folder)
*.jks
*.keystore
*.p12
*.p8
*.key
*.pem
lineage.bin
